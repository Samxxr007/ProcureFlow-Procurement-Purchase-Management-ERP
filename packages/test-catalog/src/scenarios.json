  {
    "scenarioId": "AUTH-015",
    "title": "Positive: Complete verified 3-way match invoice payment",
    "description": "Finance user can process legitimate payment once PO is fulfilled, goods receipt confirmed and invoice verified.",
    "category": "Positive Workflow",
    "initialState": "Invoice seed-inv-102 is VERIFIED with accepted GoodsReceipt and issued PO",
    "steps": [
      {
        "stepNumber": 1,
        "name": "Finance processes verified payment with unique idempotency key",
        "actorRole": "FINANCE",
        "actorEmail": "dave@procureflow.com",
        "method": "POST",
        "endpoint": "/api/payments",
        "payload": {
          "invoiceId": "seed-inv-102",
          "paymentMethod": "CORPORATE_CARD",
          "idempotencyKey": "valid-idem-key-auth-015-exec",
          "referenceNotes": "Paid per terms net 30"
        },
        "expectedHttpStatus": 201,
        "expectedPermissionOutcome": "ALLOW",
        "stateAssertions": [
          {
            "table": "Payment",
            "condition": { "idempotencyKey": "valid-idem-key-auth-015-exec" },
            "expectedCount": 1,
            "expectedFields": { "status": "COMPLETED" }
          },
          {
            "table": "Invoice",
            "condition": { "id": "seed-inv-102" },
            "expectedFields": { "status": "PAID" }
          }
        ]
      }
    ]
  }
]
