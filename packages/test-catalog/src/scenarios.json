    "steps": [
      {
        "stepNumber": 1,
        "name": "Employee attempts to query system audit log",
        "actorRole": "EMPLOYEE",
        "actorEmail": "alice@procureflow.com",
        "method": "GET",
        "endpoint": "/api/audit-events",
        "expectedHttpStatus": 403,
        "expectedPermissionOutcome": "DENY"
      },
      {
        "stepNumber": 2,
        "name": "Employee attempts to create a new user account",
        "actorRole": "EMPLOYEE",
        "actorEmail": "alice@procureflow.com",
        "method": "POST",
        "endpoint": "/api/users",
        "payload": {
          "name": "Rogue User",
          "email": "rogue@procureflow.com",
          "role": "ADMIN",
          "password": "Password123!"
