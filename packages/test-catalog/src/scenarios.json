          }
        ]
      }
    ]
  },
  {
    "scenarioId": "AUTH-011",
    "title": "Refresh token reuse detection and revocation",
    "description": "Reusing an already rotated or invalidated refresh token must immediately revoke all tokens in the family.",
    "category": "Session Lifecycle",
    "initialState": "Valid refresh token was exchanged and new token issued",
    "steps": [
      {
        "stepNumber": 1,
        "name": "Client uses an expired or already rotated refresh token",
        "actorRole": "EMPLOYEE",
        "actorEmail": "alice@procureflow.com",
        "method": "POST",
        "endpoint": "/api/auth/refresh",
        "payload": { "refreshToken": "already-consumed-refresh-token-xyz" },
        "expectedHttpStatus": 401,
        "expectedPermissionOutcome": "DENY"
      }
    ]
  },
  {
    "scenarioId": "AUTH-012",
    "title": "Resource identifier manipulation (IDOR) on supplier modification",
