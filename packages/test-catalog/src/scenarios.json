  },
  {
    "scenarioId": "AUTH-013",
    "title": "Positive: Authorized employee creates purchase requisition",
    "description": "An authenticated employee can successfully create, edit and submit their own valid purchase request.",
    "category": "Positive Workflow",
    "initialState": "Employee alice logged in with valid session",
    "steps": [
      {
        "stepNumber": 1,
        "name": "Employee creates new DRAFT purchase request",
        "actorRole": "EMPLOYEE",
        "actorEmail": "alice@procureflow.com",
        "method": "POST",
        "endpoint": "/api/purchase-requests",
        "payload": {
          "title": "Engineering Ergonomic Chairs Q3",
          "justification": "Ergonomic equipment upgrade for backend infrastructure team",
          "requiredDate": "2026-12-15T00:00:00.000Z",
          "items": [
            {
              "productId": "seed-prod-1",
              "itemDescription": "Steelcase Gesture Ergonomic Chair",
              "quantity": 3,
              "unitPrice": 850.00
            }
          ]
        },
        "expectedHttpStatus": 201,
        "expectedPermissionOutcome": "ALLOW",
        "stateAssertions": [
          {
            "table": "PurchaseRequest",
            "condition": { "title": "Engineering Ergonomic Chairs Q3" },
            "expectedCount": 1,
            "expectedFields": { "status": "DRAFT", "totalAmount": 2550.00 }
          }
        ]
      }
    ]
  },
