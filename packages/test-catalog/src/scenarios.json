        "method": "PATCH",
        "endpoint": "/api/suppliers/seed-supp-1",
        "payload": { "taxId": "FRAUDULENT-TAX-ID" },
        "expectedHttpStatus": 403,
        "expectedPermissionOutcome": "DENY",
        "stateAssertions": [
          {
            "table": "Supplier",
